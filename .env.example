# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in.  .env.local is gitignored -
# never put a real key in THIS file, it is committed to the repo.
# ---------------------------------------------------------------------------

# Which engine renders the images.
#   comfy - your own GPU. No cost per image, no cap.
#   fal   - hosted GPU. A few cents per image, needs no hardware.
RENDER_BACKEND=comfy

# --- ComfyUI (RENDER_BACKEND=comfy) ----------------------------------------
# Running ComfyUI on this same PC? Leave this as-is.
# Running it on another machine? Use that machine's IP, e.g.
#   http://192.168.1.50:8188
# and launch ComfyUI there with:  --listen 0.0.0.0 --port 8188
COMFYUI_URL=http://localhost:8188

# These must match files that actually exist on that ComfyUI server, under
# models/checkpoints and models/controlnet.
#
# The defaults are the SD 1.5 set, which is what fits a 6-8 GB card such as a
# GTX 1660 Super - see GPU_SETUP.md. On a 24 GB card use the SDXL equivalents:
#   sd_xl_base_1.0.safetensors
#   controlnet-depth-sdxl-1.0.safetensors
#   controlnet-canny-sdxl-1.0.safetensors
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly-fp16.safetensors
COMFYUI_CONTROLNET=control_v11f1p_sd15_depth_fp16.safetensors
COMFYUI_CONTROLNET_CANNY=control_v11p_sd15_canny_fp16.safetensors

# Safety net for a single render. SD 1.5 on a 1660-class card takes ~30s;
# raise this only if you are rendering on CPU.
COMFYUI_TIMEOUT_MINUTES=15

# --- fal.ai (RENDER_BACKEND=fal) -------------------------------------------
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=

# --- Instagram publishing (optional - the last step of the pipeline) --------
# Requires an Instagram Business or Creator account.
# Full walkthrough in INSTAGRAM_SETUP.md.
IG_LOGIN_TYPE=instagram
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0
